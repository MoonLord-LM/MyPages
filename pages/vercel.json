{
  "routes": [
    {
      "src": "^/service/network-proxy\\.html$",
      "status": 301,
      "headers": {
        "Location": "/service/network-proxy/index.html"
      }
    },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/$1.html", "check": true },
    { "src": "^/(.*)$", "dest": "/$1/index.html", "check": true },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}